---
import SectionHeading from "./SectionHeading.astro";
import List from "../icons/list.svg";
import UserCheck from "../icons/user-check.svg";
import Devices from "../icons/devices.svg";

const benefits = [
  { icon: List, text: "Все контакты упорядочены и под рукой." },
  { icon: UserCheck, text: "Не нужно долго вспоминать, откуда вы знаете человека." },
  { icon: Devices, text: "Удобно пользоваться как с компьютера, так и с телефона." },
];
---

<section class="relative overflow-hidden border-t border-line-section px-5 py-20 lg:px-10 lg:py-32">
  <div aria-hidden="true" class="absolute top-5 -left-35 h-110 w-155 rounded-full bg-(image:--glow-warm-blood) blur-glow-wide">
  </div>

  <div class="relative mx-auto flex max-w-page flex-col gap-8 lg:gap-10">
    <SectionHeading>Что вы получаете</SectionHeading>

    <div class="grid lg:grid-cols-3 lg:gap-x-12">
      {
        benefits.map(({ icon: Icon, text }) => (
          <div class="flex flex-col gap-5.5 border-t border-line-field py-8">
            <Icon class="size-6.5 text-ink-muted" aria-hidden="true" />
            <p class="font-heading text-benefit text-pretty lg:text-benefit-lg">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
