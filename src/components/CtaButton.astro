---
import ArrowRight from "../icons/arrow-right.svg";
import { APP_URL } from "../config";
---

<a
  href={APP_URL}
  class="mt-2 flex h-13.5 items-center gap-2.5 rounded-full bg-accent px-6.5 text-16 font-semibold text-page shadow-cta hover:bg-accent-hover hover:shadow-cta-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-accent lg:mt-3 lg:h-14.5 lg:px-7.5 lg:text-17 lg:shadow-cta-lg lg:hover:shadow-cta-lg-hover"
>
  <span>Открыть приложение</span>
  <ArrowRight class="size-4.5" aria-hidden="true" />
</a>
