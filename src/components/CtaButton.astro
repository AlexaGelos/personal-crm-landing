---
import ArrowRight from "../icons/arrow-right.svg";
import { APP_URL } from "../config";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href={APP_URL}
  class:list={[
    "relative flex h-14 items-center gap-3 rounded-edge border border-blood-line bg-blood px-6 text-center text-12 font-medium tracking-caps text-on-blood uppercase shadow-cta transition-colors duration-300 hover:border-blood-line-hover hover:bg-blood-hover focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-glow lg:gap-3.5 lg:px-8 lg:text-13",
    className,
  ]}
>
  <span>Открыть приложение</span>
  <ArrowRight class="size-4.5" aria-hidden="true" />
</a>
