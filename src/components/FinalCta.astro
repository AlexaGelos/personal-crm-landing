---
import CtaButton from "./CtaButton.astro";
import FloorCandelabrum from "./candles/FloorCandelabrum.astro";
import Tracery from "./candles/Tracery.astro";
---

<section class="px-5 pt-6 pb-20 lg:px-10 lg:pt-10 lg:pb-32">
  <div
    class="relative mx-auto flex max-w-page flex-col items-center gap-6 overflow-hidden border border-line bg-panel bg-(image:--glow-cta) px-5 py-20 text-center lg:gap-6.5 lg:px-10 lg:py-32"
  >
    <div aria-hidden="true">
      <Tracery
        simple
        class="absolute top-7 left-1/2 h-142.5 w-95 -translate-x-1/2 [mask-image:linear-gradient(#000_30%,transparent_85%)]"
      />

      {/* Two floor candelabra at the sides, each in its own pool of light */}
      <div class="hidden sconce:block">
        <div class="candle-light absolute top-1/2 -left-15 size-85 -translate-y-31/50 rounded-full"></div>
        <div
          class="candle-light absolute top-1/2 -right-15 size-85 -translate-y-31/50 rounded-full"
          style="animation-duration: 4.5s; animation-delay: -1.4s"
        >
        </div>
        <FloorCandelabrum id="cta-candelabrum-left" side="left" class="absolute top-1/2 left-14 h-82.5 w-27.5 -translate-y-1/2" />
        <FloorCandelabrum
          id="cta-candelabrum-right"
          side="right"
          class="absolute top-1/2 right-14 h-82.5 w-27.5 -translate-y-1/2"
        />
      </div>
    </div>

    <h2 class="relative max-w-205 font-heading text-cta font-light text-balance text-heading">Начните с одного человека</h2>
    <p class="relative max-w-125 text-lead font-light text-pretty text-ink-muted lg:text-lead-lg">
      Добавьте того, с кем говорили сегодня, и запишите, о чём договорились.
    </p>
    <CtaButton class="mt-2 lg:mt-3" />
  </div>
</section>
