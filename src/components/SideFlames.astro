---
// Decorative tongues of flame along the left and right edges of the screen, behind the content.
// Each edge has three tongues rising from the bottom and fading out upwards.
// Drawn for the left edge; the right edge is its mirror copy.
const sides = [
  { gradientId: "side-flames-left", position: "left-0" },
  { gradientId: "side-flames-right", position: "right-0 -scale-x-100" },
];
const flicker = "origin-bottom transform-fill";
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 text-accent">
  {
    sides.map(({ gradientId, position }) => (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 40 400"
        preserveAspectRatio="none"
        class:list={["absolute inset-y-0 h-full w-5 lg:w-20", position]}
      >
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="currentColor" stop-opacity="0" />
            <stop offset="0.5" stop-color="currentColor" stop-opacity="0.08" />
            <stop offset="1" stop-color="currentColor" stop-opacity="0.35" />
          </linearGradient>
        </defs>
        <path
          d="M0 400V230C0 170 9 140 7 100 6 80 3 68 5 50c6 28 12 60 11 110-1 50-7 80-5 130 1 40 6 70 5 110Z"
          fill={`url(#${gradientId})`}
          fill-opacity="0.8"
          class:list={[flicker, "motion-safe:animate-flame-1"]}
        />
        <path
          d="M8 400c-2-50 5-80 8-120 2-30-1-50 1-80 1-15 3-28 5-40 3 30 9 55 7 95-2 35-7 55-4 90 2 25 6 40 5 55Z"
          fill={`url(#${gradientId})`}
          class:list={[flicker, "motion-safe:animate-flame-2"]}
        />
        <path
          d="M20 400c-1-30 6-50 7-75 1-20 2-35 4-55 3 25 8 50 6 80-1 20-4 35-1 50Z"
          fill={`url(#${gradientId})`}
          fill-opacity="0.9"
          class:list={[flicker, "motion-safe:animate-flame-3"]}
        />
      </svg>
    ))
  }
</div>
