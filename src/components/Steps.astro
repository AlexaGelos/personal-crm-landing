---
import SectionHeading from "./SectionHeading.astro";
import Search from "../icons/search.svg";

const steps = [
  { numeral: "I", title: "Открываете — видите всех", text: "Сразу весь список ваших контактов." },
  { numeral: "II", title: "Добавляете человека", text: "Он сразу появляется в списке." },
  {
    numeral: "III",
    title: "Находите и дописываете",
    text: "Ищете по имени, открываете карточку и после разговора дописываете заметку.",
  },
];

// Placeholder bar widths for the list pictures in steps I and II
const listBars = ["w-29/50", "w-37/50", "w-23/50", "w-33/50"];
const newContactBars = ["w-16/25", "w-12/25", "w-7/10"];
---

<section class="relative overflow-hidden border-t border-line-section px-5 py-20 lg:px-10 lg:py-32">
  <div class="relative mx-auto flex max-w-page flex-col gap-8 lg:gap-12">
    <SectionHeading>Как это работает</SectionHeading>

    <div class="grid gap-4 lg:grid-cols-3">
      {
        steps.map(({ numeral, title, text }, index) => (
          <article class="flex flex-col gap-6 border border-line bg-card px-6 pt-7 pb-6 lg:px-7 lg:pt-8 lg:pb-7">
            <div aria-hidden="true" class="font-heading text-numeral font-light text-crimson lg:text-numeral-lg">
              {numeral}
            </div>
            <div class="flex flex-col gap-2.5">
              <h3 class="font-heading text-step-title font-medium text-heading lg:text-step-title-lg">{title}</h3>
              <p class="text-step-body text-pretty text-ink-muted">{text}</p>
            </div>

            <div aria-hidden="true" class="mt-auto flex flex-col gap-3 border border-line bg-well p-4">
              {index === 0 &&
                listBars.map((width) => (
                  <div class="flex items-center gap-2.5">
                    <span class="size-6.5 flex-none rounded-full border border-line-avatar bg-avatar" />
                    <span class:list={["h-1.75 bg-skeleton", width]} />
                  </div>
                ))}

              {index === 1 && (
                <>
                  <div class="-mx-1.5 -my-1.25 flex items-center gap-2.5 border border-blood bg-selected px-1.5 py-1.25">
                    <span class="flex size-6.5 flex-none items-center justify-center rounded-full bg-blood font-heading text-14 text-on-blood italic">
                      А
                    </span>
                    <span class="text-14 font-medium">Андрей</span>
                  </div>
                  {newContactBars.map((width) => (
                    <div class="flex items-center gap-2.5 opacity-70">
                      <span class="size-6.5 flex-none rounded-full border border-line-avatar bg-avatar" />
                      <span class:list={["h-1.75 bg-skeleton", width]} />
                    </div>
                  ))}
                </>
              )}

              {index === 2 && (
                <>
                  <div class="flex h-9 items-center gap-2 border border-line-field bg-page px-3 text-14 text-ink-faint">
                    <Search class="size-3.5 flex-none" />
                    <span class="text-ink">Андрей</span>
                  </div>
                  <div class="flex flex-col gap-1.25 border border-line-field bg-card-raised px-3.5 py-2.5">
                    <span class="text-10 font-medium tracking-label text-ink-subtle uppercase">Заметка</span>
                    <span class="flex items-center gap-0.5 text-14">
                      <span>Договорились созвониться</span>
                      <span class="h-4 w-px bg-crimson" />
                    </span>
                  </div>
                </>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
