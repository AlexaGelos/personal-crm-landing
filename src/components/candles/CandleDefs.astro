---
// Gradients, filters and the flame shape for candles. Every candle holder drawing
// puts <CandleDefs> into its <defs> once and draws candles with <Candle>;
// `id` keeps gradients of several drawings on one page apart.
// Same drawing as in the app (personal-crm, src/components/candle.tsx).
interface Props {
  id: string;
}

const { id } = Astro.props;

const FLAME_OUTER =
  "M0.6 -26C2.4 -19 4.4 -12 4.1 -6C3.8 -1.2 2.1 1.6 0 1.6C-2.1 1.6 -3.8 -1.2 -4.1 -6C-4.4 -12 -1.6 -19 0.6 -26Z";
const FLAME_INNER =
  "M0.3 -14C1.3 -10 2.1 -6.5 1.9 -3.4C1.7 -0.9 1 0.4 0 0.4C-1 0.4 -1.7 -0.9 -1.9 -3.4C-2.1 -6.5 -0.9 -10 0.3 -14Z";

const stop = (token: string, opacity = 1) => `stop-color: var(--${token}); stop-opacity: ${opacity}`;
---

<linearGradient id={`${id}-wax`} x1="0" y1="0" x2="1" y2="0">
  <stop offset="0" style={stop("wax-dark")} />
  <stop offset="0.3" style={stop("wax")} />
  <stop offset="0.5" style={stop("wax-light")} />
  <stop offset="0.72" style={stop("wax-shade")} />
  <stop offset="1" style={stop("wax-edge")} />
</linearGradient>
{/* Candle tops glow in their own light, the bottoms sink into the dark */}
<linearGradient id={`${id}-wax-lit`} x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" style={stop("wax-lit", 0.6)} />
  <stop offset="0.12" style={stop("wax-lit", 0.2)} />
  <stop offset="0.4" style={stop("wax-lit", 0)} />
  <stop offset="1" style={stop("iron-edge", 0.55)} />
</linearGradient>
<linearGradient id={`${id}-flame`} x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" style={stop("flame-tip", 0)} />
  <stop offset="0.18" style={stop("flame-mid", 0.55)} />
  <stop offset="0.5" style={stop("flame-body", 0.9)} />
  <stop offset="0.82" style={stop("flame-base")} />
  <stop offset="1" style={stop("flame-root", 0.6)} />
</linearGradient>
<linearGradient id={`${id}-core`} x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" style={stop("flame-core", 0)} />
  <stop offset="0.3" style={stop("flame-core", 0.95)} />
  <stop offset="0.8" style={stop("flame-core")} />
  <stop offset="1" style={stop("flame-core-base", 0.7)} />
</linearGradient>
<radialGradient id={`${id}-halo`}>
  <stop offset="0" style={stop("halo", 0.4)} />
  <stop offset="0.4" style={stop("halo-outer", 0.12)} />
  <stop offset="1" style={stop("halo-outer", 0)} />
</radialGradient>
<filter id={`${id}-soft`} x="-50%" y="-20%" width="200%" height="140%">
  <feGaussianBlur stdDeviation="0.45" />
</filter>
<filter id={`${id}-bloom`} x="-200%" y="-100%" width="500%" height="300%">
  <feGaussianBlur stdDeviation="3.5" />
</filter>
{/* The flame, drawn with its base at 0,0 */}
<g id={`${id}-fx`}>
  <path d={FLAME_OUTER} style="fill: var(--flame-bloom)" fill-opacity="0.6" filter={`url(#${id}-bloom)`} />
  <g filter={`url(#${id}-soft)`}>
    <path d={FLAME_OUTER} fill={`url(#${id}-flame)`} />
    <path d={FLAME_INNER} fill={`url(#${id}-core)`} />
    <ellipse cy="-0.4" rx="1.7" ry="1.3" style="fill: var(--flame-blue)" fill-opacity="0.45" />
    <path d="M0 1.6C0.2 -0.4 0.5 -1.8 1 -3" fill="none" style="stroke: var(--wick)" stroke-width="0.7" />
  </g>
</g>
