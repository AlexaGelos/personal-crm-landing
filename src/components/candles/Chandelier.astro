---
import Candle from "./Candle.astro";
import CandleDefs from "./CandleDefs.astro";
import IronDefs from "./IronDefs.astro";

// Iron ring chandelier with eight candles, hanging on a chain from the demon head.
// Candles on the ring are drawn in perspective: the back four stand on the far side
// of the ring, smaller and a little blurred; the front four stand in front of it.
interface Props {
  /** Unique on the page: names the drawing's gradients */
  id: string;
  class?: string;
  /** Thinner iron for large sizes, so the chain and ring do not look heavy */
  fine?: boolean;
}

const { id, class: className, fine = false } = Astro.props;
// Iron line widths suit a chandelier up to about 200px wide; `fine` thins them for larger ones
const w = fine ? 0.7 : 1;

const BACK = [
  { x: 42.9, y: 137, rhythm: 1 },
  { x: 134.9, y: 118.6, rhythm: 3 },
  { x: 265.1, y: 118.6, rhythm: 0 },
  { x: 357.1, y: 137, rhythm: 2 },
] as const;
const FRONT = [
  { x: 357.1, y: 163, rhythm: 0 },
  { x: 265.1, y: 181.4, rhythm: 2 },
  { x: 134.9, y: 181.4, rhythm: 1 },
  { x: 42.9, y: 163, rhythm: 3 },
] as const;
---

<svg
  aria-hidden="true"
  viewBox="0 0 400 260"
  class:list={[
    "pointer-events-none overflow-visible [mask-image:linear-gradient(rgb(0_0_0/0.6)_0%,#000_30%,#000_70%,rgb(0_0_0/0.35)_100%)]",
    className,
  ]}
>
  <defs>
    <CandleDefs id={id} />
    <IronDefs id={id} />
    <linearGradient id={`${id}-specular`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0.1" style="stop-color: var(--specular); stop-opacity: 0" />
      <stop offset="0.5" style="stop-color: var(--specular); stop-opacity: 0.32" />
      <stop offset="0.9" style="stop-color: var(--specular); stop-opacity: 0" />
    </linearGradient>
    <filter id={`${id}-depth`} x="-20%" y="-50%" width="140%" height="200%">
      <feGaussianBlur stdDeviation="1" />
    </filter>
  </defs>

  {/* Chain */}
  <path d="M200 0V104" style="stroke: var(--iron-chain)" stroke-width={3.6 * w} stroke-dasharray="7 3" />
  <path d="M200 3V104" style="stroke: var(--iron-link)" stroke-width={1.2 * w} stroke-dasharray="3 7" />

  <g opacity="0.6" filter={`url(#${id}-depth)`}>
    {
      BACK.map(({ x, y, rhythm }) => (
        <>
          <ellipse cx={x} cy={y} rx="5" ry="1.6" style="fill: var(--iron-pan)" />
          <Candle id={id} x={x} top={y - 20} height={20} width={5.5} flameScale={0.6} rhythm={rhythm} />
        </>
      ))
    }
  </g>

  {/* Arms, ring and the light the candles throw on the front of the ring */}
  <path
    d="M200 116C240 112 300 118 368 150M200 116C160 112 100 118 32 150M200 116C218 134 238 158 262 182M200 116C182 134 162 158 138 182"
    fill="none"
    style="stroke: var(--iron-rod)"
    stroke-width={3.2 * w}
  />
  <ellipse cx="200" cy="150" rx="168" ry="32" fill="none" stroke={`url(#${id}-iron)`} stroke-width={6 * w} />
  <ellipse cx="200" cy="157" rx="164" ry="31" fill="none" style="stroke: var(--iron-band)" stroke-width={2.4 * w} />
  <path d="M32 148.5A168 32 0 0 0 368 148.5" fill="none" stroke={`url(#${id}-specular)`} stroke-width={1.8 * w} />

  {/* Hub and the pendant below it */}
  <ellipse cx="200" cy="103" rx="4" ry="2" style="fill: var(--iron-collar)" />
  <ellipse cx="200" cy="112" rx="7" ry="9" fill={`url(#${id}-iron)`} />
  <path d="M200 120V186" style="stroke: var(--iron-rod)" stroke-width={3.2 * w} />
  <ellipse cx="200" cy="190" rx="5" ry="5.5" fill={`url(#${id}-iron)`} />
  <path d="M200 195L203.5 208L200 230L196.5 208Z" fill={`url(#${id}-iron)`} />

  {
    FRONT.map(({ x, y, rhythm }) => (
      <>
        <ellipse cx={x} cy={y} rx="7" ry="2.2" fill={`url(#${id}-iron)`} />
        <Candle id={id} x={x} top={y - 28} height={28} width={7} flameScale={0.85} rhythm={rhythm} />
      </>
    ))
  }
</svg>
